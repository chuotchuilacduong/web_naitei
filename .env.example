TASKHUB_ENVIRONMENT=local
TASKHUB_DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
TASKHUB_REDIS_URL=redis://localhost:6379/0
TASKHUB_REDIS_ENABLED=true
TASKHUB_SECRET_KEY=change-me-use-a-long-random-value-in-production
TASKHUB_ACCESS_TOKEN_EXPIRE_MINUTES=30
TASKHUB_REFRESH_TOKEN_EXPIRE_DAYS=7
TASKHUB_SQL_ECHO=false
TASKHUB_FIRST_USER_IS_ADMIN=true
TASKHUB_EMAIL_ENABLED=false
TASKHUB_SMTP_HOST=
TASKHUB_SMTP_PORT=587
TASKHUB_SMTP_USERNAME=
TASKHUB_SMTP_PASSWORD=
TASKHUB_SMTP_FROM_EMAIL=noreply@taskhub.local
